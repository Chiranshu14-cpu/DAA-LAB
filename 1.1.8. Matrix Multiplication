#include <stdio.h>

int main() {
	int m, n, p, q;
	int i, j, k;

	if (scanf("%d %d", &m, &n) != 2) return 0;

	int A[m][n];

	for (i = 0; i < m; i++) {
		for (j = 0; j < n; j++) {
			scanf("%d", &A[i][j]);
		}
	}

	if (scanf("%d %d", &p, &q) != 2) return 0;

	if (n != p) {
		printf("Invalid input\n");
		return 0; 
	}

	int B[p][q];
	int C[m][q];

	for (i = 0; i < p; i++) {
		for (j = 0; j < q; j++) {
			scanf("%d", &B[i][j]);
		}
	}

	for (i = 0; i < m; i++) {
		for (j = 0; j < q; j++) {
			C[i][j] = 0; 
			for (k = 0; k < n; k++) {
				C[i][j] += A[i][k] * B[k][j];
			}

			printf("%d ", C[i][j]);
		}
		printf("\n");
	}
	return 0;
}
